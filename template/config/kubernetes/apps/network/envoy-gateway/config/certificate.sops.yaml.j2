---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: "#{ domain.name.replace('.', '-') }#-production"
spec:
  dnsNames:
    - "${SECRET_DOMAIN}"
    - "*.${SECRET_DOMAIN}"
  duration: 160h
  issuerRef:
    name: #{ cluster_issuer }#
    kind: ClusterIssuer
  privateKey:
    algorithm: ECDSA
  secretName: "#{ domain.name.replace('.', '-') }#-production-tls"
  usages:
    - digital signature
